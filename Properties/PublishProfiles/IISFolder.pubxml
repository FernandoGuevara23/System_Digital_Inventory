<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <EnvironmentName>Production</EnvironmentName>
    <PublishDir>$(MSBuildProjectDirectory)\..\Publicacion-IIS\sitio\</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="frontend-inventario\**;publish\**;uploads\**;appsettings.*.json" CopyToPublishDirectory="Never" />
    <None Update="frontend-inventario\**;publish\**;uploads\**;appsettings.*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="CheckAngularIIS" BeforeTargets="Publish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\frontend-inventario\dist\frontend-inventario\browser\index.html')" Text="Compila Angular antes de publicar: npm.cmd run build --prefix TRG2.0_VNET/frontend-inventario" />
  </Target>
  <Target Name="IncludeAngularIIS" AfterTargets="Publish">
    <ItemGroup>
      <AngularIIS Include="$(MSBuildProjectDirectory)\frontend-inventario\dist\frontend-inventario\browser\**\*" Exclude="$(MSBuildProjectDirectory)\frontend-inventario\dist\frontend-inventario\browser\**\web.config" />
    </ItemGroup>
    <Copy SourceFiles="@(AngularIIS)" DestinationFiles="@(AngularIIS->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(PublishDir)wwwroot\web.config" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\deploy\iis\appsettings.Production.template.json" DestinationFiles="$(PublishDir)appsettings.Production.json" />
    <MakeDir Directories="$(PublishDir)logs" />
  </Target>
</Project>
