    <ProjectGuid>8c10ed87-c0f6-b46b-3976-1fb86bfbd942</ProjectGuid>
    <SelfContained>false</SelfContained>
    <publishUrl>$(MSBuildProjectDirectory)\..\publicacion8.0\</publishUrl>
