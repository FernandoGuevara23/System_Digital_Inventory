<Project>
  <Import Project="IISFolder.pubxml" />
  <PropertyGroup>
    <PublishDir>$(MSBuildProjectDirectory)\..\publicacion8.0\</PublishDir>
    <WebPublishMethod>FileSystem</WebPublishMethod>
